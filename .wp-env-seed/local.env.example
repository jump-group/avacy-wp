# Local Avacy plugin seed for wp-env
# Copy this file to `local.env` (gitignored) and fill with values from your test tenant.
# `.wp-env-seed/seed.sh` reads this file at every `yarn wp:start` to pre-configure the plugin.
# Leave a value empty to skip setting that option.

# Avacy tenant identifier (team name)
AVACY_TENANT=""

# Webspace key for the tenant (new format: "<key>|<account_token>" or legacy key only)
AVACY_WEBSPACE_KEY=""

# Consent Solution API token (optional, used for form consent logging)
AVACY_API_TOKEN=""

# Banner display toggle — "on" or empty
AVACY_SHOW_BANNER="on"

# Preemptive script blocking toggle — "on" or empty
AVACY_ENABLE_PREEMPTIVE_BLOCK="on"
