{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "login": true,
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      }
    },
    {
      "step": "wp-cli",
      "command": "wp plugin activate avacy"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "avacy_webspace_key": "test-harness|11111111-1111-1111-1111-111111111111",
        "avacy_show_banner": "on",
        "avacy_test_harness_enabled": "on",
        "avacy_test_woo_enabled": "on"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/wp-content/plugins/avacy/tests/fixtures/seed-woo-forms.php';"
    }
  ]
}
