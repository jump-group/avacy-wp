msgstr "Newsletter"

#: src/ConsentFeatures.php:31
msgid "Marketing"
msgstr "Marketing"

#: src/ConsentFeatures.php:32
msgid "Third-party marketing"
msgstr "Marketing di terze parti"

#: src/ConsentFeatures.php:33
msgid "Profiling"
msgstr "Profilazione"

