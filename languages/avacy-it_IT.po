#. Plugin Name of the plugin
#: avacy.php
msgid "Avacy: GDPR Consent Solution, Cookie Banner and more"
msgstr "Avacy: consenso GDPR, cookie banner e altro"

#. Plugin URI of the plugin
#: avacy.php
msgid "https://avacysolution.com/"
msgstr "https://avacysolution.com/"

#. Description of the plugin
#: avacy.php
msgid ""
"Avacy's compliance plugin offers an all-in-one, easy solution for a GDPR "
"compliant website, with features verified by experienced lawyers."
msgstr ""
"Il plugin di Avacy è una soluzione completa e semplice per rendere il tuo "
"sito conforme al GDPR, con funzioni verificate da avvocati esperti."

#. Author of the plugin
#: avacy.php
msgid "Jump Group"
msgstr "Jump Group"

#: src/AddAdminInterface.php:60
msgid ""
"Avacy could not be reached, so nothing was removed. Please try again later."
msgstr ""
"Avacy non è raggiungibile e non è stato rimosso niente. Riprova più tardi."

#: src/AddAdminInterface.php:70
msgid ""
"Avacy can't load the data of this account. Please contact Avacy support."
msgstr ""
"Avacy non riesce a caricare i dati di questo account. Contatta il supporto "
"di Avacy."

#: src/AddAdminInterface.php:169 src/PreemptiveBlock.php:248
msgid "You do not have sufficient permissions to access this page."
msgstr "Non hai i permessi sufficienti per accedere a questa pagina."

#: src/AddAdminInterface.php:237
msgid "The changes have been saved successfully."
msgstr "Le modifiche sono state salvate."

#: src/AddAdminInterface.php:306
msgid "Team not found. Please check the entered data."
msgstr "Team non trovato. Controlla i dati inseriti."

#: src/AddAdminInterface.php:313
msgid "Webspace not found. Please check the entered data."
msgstr "Spazio web non trovato. Controlla i dati inseriti."

#: src/AddAdminInterface.php:364
msgid "The entered credentials are valid."
msgstr "Le credenziali inserite sono valide."

#: src/AddAdminInterface.php:420
msgid "The entered Access Key has an incorrect format."
msgstr "L'Access Key inserita ha un formato errato."

#: src/AddAdminInterface.php:427
msgid "Access Key not found or expired. Please check the entered data."
msgstr "Access Key non trovata o scaduta. Controlla i dati inseriti."

#: src/AddAdminInterface.php:447
msgid "The Access Key has been saved successfully."
msgstr "L'Access Key è stata salvata."

#: src/AddAdminInterface.php:456
msgid "The Access Key has been removed successfully."
msgstr "L'Access Key è stata rimossa."

#. translators: %s: name of the form.
#: src/AddAdminInterface.php:585
#, php-format
msgid "Form \"%s\" was not saved: choose the user identifier field."
msgstr ""
"Il form «%s» non è stato salvato. Scegli il campo di identificazione utente."

#: src/AddAdminInterface.php:676 src/views/avacy-dashboard.php:290
msgid "User identification field"
msgstr "Campo di identificazione utente"

#: src/AddAdminInterface.php:689
msgid "Avacy: some forms need your attention."
msgstr "Avacy: alcuni form richiedono la tua attenzione."

